# The Django API base URL. Leave this as /api for local Vite development; the
# proxy target is configured separately below. Do not include a trailing slash.
VITE_API_URL=/api
# Used by Vite's development proxy only. In Docker Compose this is overridden
# with http://backend:8000.
VITE_BACKEND_URL=http://localhost:8000
# Optional: set this only for a single-tenant deployment.
VITE_TENANT_SLUG=
